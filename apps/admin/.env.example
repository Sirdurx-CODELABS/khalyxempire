# Backend API origin (no trailing slash, no /api — the app appends /api)
# Local leave empty to use Vite proxy → http://localhost:5000
# Vercel: set these in Project → Settings → Environment Variables
VITE_API_URL=https://YOUR-API.onrender.com

# Optional: link to ERP from Admin sidebar (production URL, no trailing slash)
VITE_ERP_URL=https://YOUR-ERP.vercel.app
