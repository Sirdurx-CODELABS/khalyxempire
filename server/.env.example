PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ERP_URL=http://localhost:5175
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# MongoDB Atlas connection string
MONGODB_URI=

# Paystack — paste test keys from https://dashboard.paystack.com/#/settings/developers
# When SECRET is set, checkout offers Paystack instead of "Test payment"
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Webhook URL (Paystack dashboard → Settings → API Keys & Webhooks):
#   {API_PUBLIC_URL}/api/payments/paystack/webhook
# Signature uses PAYSTACK_SECRET_KEY (x-paystack-signature)

# Flutterwave — paste keys from https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Secret hash from Flutterwave → Settings → Webhooks (required for webhooks)
FLUTTERWAVE_WEBHOOK_HASH=
# Webhook URL:
#   {API_PUBLIC_URL}/api/payments/flutterwave/webhook
# Header: verif-hash = FLUTTERWAVE_WEBHOOK_HASH

# Public API origin used in webhook URL helpers (Admin → Settings)
# Local: http://localhost:5000
# Tunnel / production: https://your-api.onrender.com
API_PUBLIC_URL=http://localhost:5000

# Order confirmation email (optional — logs to console if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Khalyx Empire <orders@khalyx.ng>

# WhatsApp Business number in international format, no plus (e.g. 2348012345678)
WHATSAPP_BUSINESS_NUMBER=2348000000000
WHATSAPP_GROUP_URL=https://chat.whatsapp.com/FcNOmy0VdI6ISNDi1stgSx

# Shipping
FLAT_SHIPPING_FEE=2500
FREE_SHIPPING_THRESHOLD=150000

# Auth0 Google sign-in for the storefront
# 1. Create a Regular Web Application at https://manage.auth0.com
# 2. Enable Google under Authentication → Social
# 3. Allowed Callback URLs MUST be the API host (not Vercel):
#      Local:      http://localhost:5000/api/auth/auth0/callback
#      Production: https://YOUR-API.onrender.com/api/auth/auth0/callback
# 4. Allowed Logout URLs + Allowed Web Origins: your storefront origin
#      Local:      http://localhost:5173
#      Production: https://YOUR-STOREFRONT.vercel.app
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:5000/api/auth/auth0/callback
