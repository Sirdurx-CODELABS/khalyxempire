PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ERP_URL=http://localhost:5175
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# MongoDB Atlas connection string
MONGODB_URI=

# Paystack (test keys)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave (test keys)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Order confirmation email (optional — logs to console if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Khalyx Empire <orders@khalyx.ng>

# WhatsApp Business number in international format, no plus (e.g. 2348012345678)
WHATSAPP_BUSINESS_NUMBER=2348000000000

# Shipping
FLAT_SHIPPING_FEE=2500
FREE_SHIPPING_THRESHOLD=150000

# Auth0 Google sign-in for the storefront
# Create a Regular Web Application at https://manage.auth0.com
# Allowed Callback URLs: http://localhost:5173/api/auth/auth0/callback
# Allowed Logout URLs: http://localhost:5173
# Allowed Web Origins: http://localhost:5173
# Enable the Google social connection on that app.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://localhost:5173/api/auth/auth0/callback
